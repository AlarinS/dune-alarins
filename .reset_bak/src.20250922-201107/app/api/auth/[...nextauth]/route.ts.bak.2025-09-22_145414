import NextAuth from "next-auth"
import Credentials from "next-auth/providers/credentials"
import { PrismaAdapter } from "@next-auth/prisma-adapter"
import { PrismaClient } from "@prisma/client"
import { scryptSync, timingSafeEqual } from "crypto"

export const runtime = "nodejs"

const prisma = new PrismaClient()

function verifyScrypt(password: string, stored: string) {
  try {
    const [, , salt, hashHex] = stored.split("$")
    if (!salt || !hashHex) return false
    const testHex = scryptSync(password, salt, 64).toString("hex")
    const a = Buffer.from(hashHex, "hex")
    const b = Buffer.from(testHex, "hex")
    return a.length === b.length && timingSafeEqual(a, b)
  } catch {
    return false
  }
}

async function verifyPassword(password: string, stored?: string | null) {
  if (!stored) return false
  if (stored.startsWith("scrypt$")) return verifyScrypt(password, stored)
  return false
}

export const { handlers: { GET, POST }, auth } = NextAuth({
  adapter: PrismaAdapter(prisma),
  providers: [
    Credentials({
      name: "Логин и пароль",
      credentials: {
        username: { label: "Логин", type: "text" },
        password: { label: "Пароль", type: "password" }
      },
      async authorize(creds) {
        if (!creds?.username || !creds?.password) return null
        const user = await prisma.user.findFirst({
          where: { OR: [{ username: creds.username }, { email: creds.username }] }
        })
        if (!user?.passwordHash) return null
        const ok = await verifyPassword(creds.password, user.passwordHash)
        if (!ok) return null
        return { id: user.id, name: user.name ?? user.username ?? "", email: user.email ?? undefined }
      }
    })
  ],
  pages: { signIn: "/signin", error: "/signin" },
  session: { strategy: "jwt" },
  callbacks: {
    async session({ session, token }) {
      if (session.user && token?.sub) (session.user as { id?: string }).id = token.sub
      return session
    },
    async redirect({ url, baseUrl }) {
      try {
        const u = new URL(url, baseUrl)
        if (u.origin === baseUrl) return u.toString()
      } catch {}
      return baseUrl + "/admin"
    }
  }
})
