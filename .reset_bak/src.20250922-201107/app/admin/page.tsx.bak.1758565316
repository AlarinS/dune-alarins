import { auth } from "../../auth"

export default async function AdminHome(){
  const session = await auth()
  return (
    <div style={{padding:24,fontFamily:"Inter,system-ui"}}>
      <h1 style={{fontSize:28,marginBottom:8}}>Админка</h1>
      <div style={{opacity:.8,marginBottom:16}}>
        Привет, {session?.user?.name ?? session?.user?.email ?? "админ"}.
      </div>
      <a href="/admin/users">Управление пользователями</a>
    </div>
  )
}
