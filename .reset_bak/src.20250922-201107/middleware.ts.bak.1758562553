import { auth } from "@/auth";

const PUBLIC_PATHS = [
  "/signin",
  "/signin",
  "/api/auth",
  "/_next",
  "/favicon.ico",
  "/robots.txt",
  "/sitemap.xml",
];

export default auth((req) => {
  const { nextUrl } = req;

  // Разрешаем публичные пути
  if (PUBLIC_PATHS.some((p) => nextUrl.pathname === p || nextUrl.pathname.startsWith(p + "/"))) {
    return;
  }

  // Защищаем только /admin/**
  if (!nextUrl.pathname.startsWith("/admin")) return;

  // Неавторизованных отправляем на /signin с ОДНИМ callbackUrl
  if (!req.auth) {
    const signInUrl = new URL("/signin", nextUrl);
    if (!signInUrl.searchParams.has("callbackUrl")) {
      signInUrl.searchParams.set("callbackUrl", nextUrl.pathname + nextUrl.search);
    }
    return Response.redirect(signInUrl);
  }
});

export const config = { matcher: ["/admin/:path*"] };
