generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Item {
  id        Int      @id @default(autoincrement())
  name      String   @db.NVarChar(200)
  level     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Npc {
  id        Int      @id @default(autoincrement())
  name      String   @db.NVarChar(200)
  faction   String?  @db.NVarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id        Int      @id @default(autoincrement())
  name      String   @db.NVarChar(200)
  power     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Health {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @map("ts") @default(dbgenerated("getdate()"))
}

/// --- Auth.js (NextAuth) models ---
model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.NVarCharMax
  @db.NVarCharMaxaccess_token      String?
  @db.NVarCharMaxexpires_at        Int?
  token_type        String?
         scope             String?  @db.NVarCharMax
  @db.NVarCharMaxid_token          String?
  @db.NVarCharMaxsession_state     String?
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
