generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Item {
  id        Int      @id @default(autoincrement())
  name      String   @db.NVarChar(200)
  level     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Npc {
  id        Int      @id @default(autoincrement())
  name      String   @db.NVarChar(200)
  faction   String?  @db.NVarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id        Int      @id @default(autoincrement())
  name      String   @db.NVarChar(200)
  power     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Health {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
}
