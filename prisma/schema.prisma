generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Item {
  id        Int      @id @default(autoincrement())
  name      String   @db.NVarChar(200)
  level     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Npc {
  id        Int      @id @default(autoincrement())
  name      String   @db.NVarChar(200)
  faction   String?  @db.NVarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id        Int      @id @default(autoincrement())
  name      String   @db.NVarChar(200)
  power     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Health {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(dbgenerated("getdate()")) @map("ts")
}

/// --- NextAuth (v4) ---
model User {
  username      String?   @unique @db.NVarChar(64)
  passwordHash  String?            @db.NVarChar(100)
  role          String    @default("ADMIN") @db.NVarChar(16)
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.NVarChar(4000)
  access_token      String? @db.NVarChar(4000)
  expires_at        Int?
  token_type        String?
  scope             String? @db.NVarChar(4000)
  id_token          String? @db.NVarChar(4000)
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
